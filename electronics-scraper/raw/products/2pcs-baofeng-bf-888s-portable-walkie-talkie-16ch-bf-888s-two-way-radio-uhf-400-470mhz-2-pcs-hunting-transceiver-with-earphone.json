    "body_html": "<div class=\"detailmodule_dynamic\"><widget data-widget-type=\"customText\" id=\"24685766\" title=\"\" type=\"custom\"></widget></div>\n\n<div class=\"detailmodule_text\">\n<p class=\"detail-desc-decorate-title\" style=\"text-overflow: ellipsis;font-family: 'OpenSans';color:'#000';word-wrap: break-word;white-space: pre-wrap;font-weight: 900;font-size: 20px;line-height: 28px;color: #000;margin-bottom: 12px;\">Walkie talkie baofeng bf-888s 2 pcs two-way radio</p>\n\n<p class=\"detail-desc-decorate-content\" style=\"text-overflow: ellipsis;font-family: 'OpenSans';color:'#000';word-wrap: break-word;white-space: pre-wrap;font-weight: 300;font-size: 14px;line-height: 20px;color: #000;margin-bottom: 12px;\">50 CTCSS/105 CDCSS VOX Function Voice Prompt PC Programming Emergency Alarm Intelligent Charging Battery Save Low Voltage Alert Time-out Timer Torch Light General Frequency Range: 400-470MHz Channel Capacity: 16 Operated Voltage: 3.7V Battery Capacity: 1500mAh Li-ion</p>\n</div>\n\n<div class=\"detailmodule_text\">\n<p class=\"detail-desc-decorate-title\" style=\"text-overflow: ellipsis;font-family: 'OpenSans';color:'#000';word-wrap: break-word;white-space: pre-wrap;font-weight: 900;font-size: 20px;line-height: 28px;color: #000;margin-bottom: 12px;\">Package include:</p>\n\n<p class=\"detail-desc-decorate-content\" style=\"text-overflow: ellipsis;font-family: 'OpenSans';color:'#000';word-wrap: break-word;white-space: pre-wrap;font-weight: 300;font-size: 14px;line-height: 20px;color: #000;margin-bottom: 12px;\">2 x Baofeng BF-888S Radio 2 x 3.7V 1500mAh Li-ion Battery 2 x SMA-Female Dual Band Antenna 2 x Belt Clip 2 x ENG Manual 2 x Desktop Charger 2 x Wrist Strap 2 x Earpiece</p>\n</div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB1vqsKXZrrK1Rjy1zeq6xalFXaT.jpg\" alt=\"2pcs baofeng bf-888s portable walkie talkie 16ch bf 888s two way radio uhf 400-470mhz 2 pcs hunting transceiver with earphone\" loading=\"lazy\"></div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB1jc.BX.vrK1RjSspcq6zzSXXaH.jpg\" alt=\"2pcs baofeng bf-888s portable walkie talkie 16ch bf 888s two way radio uhf 400-470mhz 2 pcs hunting transceiver with earphone\" loading=\"lazy\"></div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB1fpwHX2vsK1Rjy0Fiq6zwtXXah.jpg\" alt=\"2pcs baofeng bf-888s portable walkie talkie 16ch bf 888s two way radio uhf 400-470mhz 2 pcs hunting transceiver with earphone\" loading=\"lazy\"></div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB1jZZJX0fvK1RjSszhq6AcGFXaH.jpg\" alt=\"2pcs baofeng bf-888s portable walkie talkie 16ch bf 888s two way radio uhf 400-470mhz 2 pcs hunting transceiver with earphone\" loading=\"lazy\"></div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB1sM.OX2jsK1Rjy1Xaq6zispXa2.jpg\" alt=\"2pcs baofeng bf-888s portable walkie talkie 16ch bf 888s two way radio uhf 400-470mhz 2 pcs hunting transceiver with earphone\" loading=\"lazy\"></div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB1bpwHX2vsK1Rjy0Fiq6zwtXXaG.jpg\" alt=\"2pcs baofeng bf-888s portable walkie talkie 16ch bf 888s two way radio uhf 400-470mhz 2 pcs hunting transceiver with earphone\" loading=\"lazy\"></div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB14ZADX2fsK1RjSszbq6AqBXXai.jpg\" alt=\"2pcs baofeng bf-888s portable walkie talkie 16ch bf 888s two way radio uhf 400-470mhz 2 pcs hunting transceiver with earphone\" loading=\"lazy\"></div>\n\n<div class=\"detailmodule_image\"><img class=\"detail-desc-decorate-image\" src=\"https://ae01.alicdn.com/kf/HTB1GvgBXVzsK1R